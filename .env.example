# =====================================================================
# BuildiFy WMS - 환경변수 예시
#   cp .env.example .env  후 값을 채워서 사용하세요.
#   .env 는 .gitignore 대상이며 절대 커밋하지 않습니다.
# =====================================================================

# ---------- 데이터베이스 ----------
DB_NAME=buildifydb
DB_USERNAME=buildify
DB_PASSWORD=변경하세요_앱용비밀번호
MYSQL_ROOT_PASSWORD=변경하세요_루트비밀번호

# RDS 등 외부 DB 를 쓸 때만 지정합니다. (지정하면 DB_HOST/PORT/NAME 대신 이 값이 사용됩니다)
# DB_URL=jdbc:mysql://your-rds-endpoint:3306/buildifydb?serverTimezone=Asia/Seoul&characterEncoding=UTF-8&useSSL=true

# ---------- 애플리케이션 ----------
APP_PORT=8080

# ---------- 외부 API 키 (없으면 해당 기능만 비활성, 기동은 정상) ----------
# 뉴스 위젯은 구글 뉴스 RSS 를 서버에서 조회하므로 키가 필요 없습니다.
# 카카오 지도  https://developers.kakao.com
KAKAO_REST_KEY=
KAKAO_JAVASCRIPT_KEY=
# 날씨         https://openweathermap.org/api
OPENWEATHER_API_KEY=
